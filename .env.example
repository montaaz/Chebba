# PostgreSQL — local database "maysen"
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maysen
# connections kept open per server process
DATABASE_POOL_MAX=10

# Public address of the site (used for links and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin account created by `npm run db:seed`
ADMIN_EMAIL=admin@chebba.local
ADMIN_PASSWORD=change-me-at-least-10-chars
ADMIN_NAME=Administrateur

# Map services (free public servers by default — see README before going live)
OSRM_URL=https://router.project-osrm.org
GEOCODER_URL=https://photon.komoot.io
NEXT_PUBLIC_TILE_URL=https://{s}.tile.openstreetmap.fr/osmfr/{z}/{x}/{y}.png

# E-mail notifications (optional). Leave SMTP_URL empty to disable e-mail:
# the bell and WhatsApp messages keep working without it.
# Example: smtp://user:password@smtp.example.com:587  (use smtps:// for port 465)
SMTP_URL=
MAIL_FROM=Chebba Auto Car <no-reply@example.com>
